# หมายเหตุ (2026-08-03, Module 3): ไฟล์นี้เพิ่งถูกโหลดจริงเป็นครั้งแรกโดย backend/config.py's
# load_dotenv() — ก่อนหน้านี้ backend ไม่เคยเรียก load_dotenv() เลย (บั๊กที่พบจาก mantra 4 cross-
# reference ดู requirements.txt) ค่าใน .env จริงบนเครื่องที่ตั้งไว้ก่อนหน้านี้ (เช่น COMPANY_NAME)
# เพิ่งจะมีผลจริงตั้งแต่ตอนนี้เป็นต้นไป

# Database and RAG Settings
COMPANY_NAME=บริษัทของคุณ
VECTOR_DB_PATH=./storage

# Azure AD SSO (For Global Admin)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# API Keys
# GOOGLE_API_KEY: ใช้ทั้ง Module 3 (Minutes Generation, ดูด้านล่าง) — ตัดสินใจ (task.md Module 3):
# เนื้อหาบอร์ดเป็นความลับสูง ใช้ paid tier ตั้งแต่ทดสอบด้วยเนื้อหาจริงครั้งแรก (เหมือน rag_worker's
# .env.example — ทดสอบด้วยข้อมูลสมมติบน free tier ได้ปกติ)
GOOGLE_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY: ไม่ได้ใช้จริง — Module 3 ตัดสินใจใช้ Gemini ไม่ใช่ Claude (ดู implementation_plan.md
# ข้อ Decisions #5) ค้างมาจาก scaffold เริ่มต้นโปรเจกต์ เก็บไว้เผื่ออนาคตต้องการจริงๆ

ANTHROPIC_API_KEY=your-claude-api-key

# ── Module 3: Minutes Generation (Gemini native structured output) ─────────────────────────
GEMINI_MODEL_MINUTES=gemini-3.5-flash
GEMINI_MODEL_MINUTES_FALLBACK=gemini-3-flash-preview,gemini-2.5-flash
GEMINI_MINUTES_TIMEOUT_MS=300000

# ── Gemini native audio transcription+diarization (production path, backend/audio_native.py) ──
# primary=3.6-flash (เสถียรสุดจากผลทดสอบจริง) — fallback ขยายเป็น 3 ตัว (2026-08-05, session 3.32
# หลังเจอ 503 "high demand" ชั่วคราวกลางไฟล์ยาวจริง fallback เดียวไม่พอกันความเสี่ยง Google มีปัญหา
# capacity ชั่วคราว) เรียงจากผลจริงใน model_comparison_results/batch_drift_summary.csv — ไม่ใส่
# gemini-3.1-flash-lite (undershoot สม่ำเสมอ) และ gemini-2.5-flash-lite (fail ไม่เสถียร) ดู
# config.py's comment สำหรับรายละเอียดเต็ม
GEMINI_MODEL_TRANSCRIPTION=gemini-3.6-flash
GEMINI_MODEL_TRANSCRIPTION_FALLBACK=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_TRANSCRIPTION_TIMEOUT_MS=900000

# ── Module 4: Word Template Mapping ─────────────────────────────────────────────────────
# ที่อยู่บริษัทที่แสดงในเอกสาร .docx ที่ AI ร่าง (ไม่มีใน minutes_json — ปล่อยว่างได้)
COMPANY_ADDRESS=

# ── Module 5: Finalization & Secure Delivery ────────────────────────────────────────────
# SMTP ธรรมดา (ไม่ใช่ Microsoft Graph API — Azure AD ยังไม่เชื่อมต่อจริง ดู auth.py) ใช้ส่ง Magic
# Link ให้ Board_Member หลัง Checker Approve — ⚠️ ยังไม่เคยตั้งค่า/ทดสอบจริงเลยสักครั้ง (sandbox
# ไม่มี SMTP server จริงให้ทดสอบ) ต้องกรอกค่าจริงก่อนใช้งาน ไม่งั้น endpoint /review (approve) จะ
# แค่ log warning ว่าส่งอีเมลไม่สำเร็จ ไม่ crash ทั้ง flow
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=comsec@example.com

# Magic Link — ⚠️ MAGIC_LINK_BASE_URL ต้องเป็น URL ที่ Board_Member เปิดได้จริงจากเครื่องเขา (ไม่ใช่
# 127.0.0.1 ถ้า backend รันอยู่คนละเครื่อง/ต้องผ่าน VPN) ตัดสินใจจาก /scrutinize ว่าต้องมี expiration
# + single-use ตั้งแต่ตอนออกแบบ (ดู task.md Module 4-5)
MAGIC_LINK_BASE_URL=http://127.0.0.1:8000
MAGIC_LINK_EXPIRY_HOURS=168

# Archive ปลายทาง (ตัดสินใจจาก /grill-me รอบ 2) — แยก 2 ปลายทางตามชั้นความลับ ค่าว่าง = ข้ามการ
# archive (log warning เฉยๆ ไม่ทำให้ approve ล้มเหลว) ต้องเป็น UNC path/mapped drive จริงก่อนใช้งาน
ARCHIVE_DOCUMENTS_DESTINATION=
ARCHIVE_RECORDINGS_DESTINATION=
