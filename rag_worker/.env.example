# Com Sec RAG Worker — ตัวอย่างไฟล์ .env (copy เป็น .env แล้วใส่ค่าจริง — .env ต้อง gitignore)

# ── Gemini API ─────────────────────────────────────────────────────────────
# ตัดสินใจ (task.md Module 3, implementation_plan.md ข้อ 7): เนื้อหาบอร์ดเป็นความลับสูง
# ใช้ paid tier ตั้งแต่ทดสอบด้วยเนื้อหาจริงครั้งแรก (ทดสอบด้วยข้อมูลสมมติบน free tier ได้ปกติ)
GOOGLE_API_KEY=your-gemini-api-key-here

# ── ชื่อองค์กร (ใช้ในระบบ prompt) ────────────────────────────────────────────
COMPANY_NAME=ออริจิ้น โกลบอล เอ็มไพร์

# ── path ไปยัง Local RAG (Policy RAG Assistant) — ต้องชี้ไปที่โฟลเดอร์เดียวกับที่ Local RAG ────
# ใช้จริง เพื่อไม่ให้ corpus/FAISS index สองระบบ drift กัน (ดู worker_config.py) ── ปรับถ้าย้ายที่เก็บ
SHARED_RAG_DIR=D:\Review Policy\Local  RAG

# ── โมเดล Gemini แยกตามโหมด (ค่าเริ่มต้นเหมือน Local RAG) ─────────────────────
GEMINI_MODEL_CHAT=gemini-3.1-flash-lite
GEMINI_MODEL_DRAFT=gemini-3.5-flash

# โมเดลสำรอง (comma-separated, ไล่ทีละตัวถ้าโมเดลหลักชนโควตาต่อเนื่อง — ดู ADR-003 ของ Local RAG)
GEMINI_MODEL_CHAT_FALLBACK=gemma-4-26b-a4b-it,gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-2.5-flash
GEMINI_MODEL_DRAFT_FALLBACK=gemma-4-31b-it,gemma-4-26b-a4b-it,gemini-3-flash-preview,gemini-2.5-flash

# ── Session / timeout ────────────────────────────────────────────────────────
SESSION_IDLE_TIMEOUT_SECONDS=28800
GEMINI_REQUEST_TIMEOUT_MS=300000

# ── พอร์ตของ worker นี้ (แยกจาก Local RAG's 8765 กันชนกันถ้ารันพร้อมกัน) ────────
COM_SEC_RAG_WORKER_PORT=8766
