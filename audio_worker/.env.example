# Com Sec Audio Worker — ตัวอย่างไฟล์ .env (copy เป็น .env แล้วปรับค่าจริง — .env ต้อง gitignore)

# ── พอร์ตของ worker นี้ (แยกจาก backend หลัก 8000 และ RAG worker 8766) ────────
AUDIO_WORKER_PORT=8767

# ── Hugging Face — จำเป็นก่อนรันครั้งแรก ─────────────────────────────────────
# `pyannote/segmentation` เป็น gated model ต้อง accept terms ที่
# https://hf.co/pyannote/segmentation แล้ว login ครั้งเดียวด้วย (ไม่ใช่ env var — cache
# ที่ user level ใช้ได้กับทุก Python env บนเครื่องนี้):
#   huggingface-cli login

# ── ASR per-segment (redesign 2026-08-02: diarization เต็มไฟล์เสมอ, ASR ตัดใหม่ทีละ diarization
# segment ตรงๆ แทนชิ้นละ 1 ชม. เดิม) — ค่านี้คือ**เพดาน**วินาทีต่อ segment ที่ยอมส่งเข้าโมเดลทีเดียว
# (segment ที่ยาวเกินจะถูก sub-split) ไม่ใช่ขนาด chunk คงที่แล้ว — default 20s อ้างอิงจาก
# typhoon-asr/examples/finetune.py's train_ds.max_duration (ของจริงในซอร์ส, ตรวจแล้ว)
ASR_MAX_SEGMENT_SECONDS=20

# segment สั้นกว่านี้ (วินาที) ข้ามไปเลย ไม่ส่งเข้าโมเดล — กันขอบเขตทางเทคนิคเท่านั้น (ffmpeg/model
# เจอ input สั้นผิดปกติ) ไม่ใช่ตัวกรองคุณภาพแล้ว (เคยลองขึ้น 0.5 เป็น duration-heuristic กรอง
# segment ว่างเปล่า — live test พิสูจน์ว่า duration ไม่ correlate กับคุณภาพผลลัพธ์ เปลี่ยนไปกรองจาก
# ผลจริงหลัง transcribe ใน asr.py แทน — ดู worker_config.py's comment/handoff.md 3.4)
ASR_MIN_SEGMENT_SECONDS=0.1

# ── GPU fallback ───────────────────────────────────────────────────────────
# ถ้า VRAM ไม่พอ (torch.cuda.OutOfMemoryError) ตกไปใช้ CPU อัตโนมัติ — true/false
CPU_FALLBACK_ON_OOM=true

# ── path (ปกติไม่ต้องแก้ ใช้ default ที่ worker_config.py คำนวณให้) ──────────────
# AUDIO_UPLOAD_DIR=D:\Com Sec\backend\uploads
# AUDIO_PROCESSED_DIR=D:\Com Sec\audio_worker\processed
# DIARIZATION_CHECKPOINT_DIR=D:\Com Sec\Diarization_ThaiSpeech_2022\checkpoints
